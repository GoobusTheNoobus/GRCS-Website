import Layout from "../layouts/Layout.astro";
import "../styles/style.css"
---

<Layout title="泓河中文学校  |  GRCS" lang="en">
	<main>
        <div class="titles">
			<h1 lang="zh-CN" class="title-zh">泓河中文学校</h1>
			<h1 lang="en" class="title-en">Grand River Chinese School</h1>
		</div>
		
		<div class="subtitles">
			<p lang="zh-CN">请选择您的语言</p>
			<p lang="en">Please select your language</p>
		</div>
		
		<nav aria-label="Choose your language">
			<div lang="zh-CN" id="nav-cn">
				<h1>简体中文</h1>
				<p>欢迎来到我们的学校!</p>
				<a href="/zh/">进入网站 {"->"}</a>
			</div>
			<div lang="en" id="nav-en">
				<h1>English</h1>
				<p>Welcome to our school!</p>
				<a href="/en/">Continue {"->"}</a>
			</div>
		</nav> 
    </main>	
</Layout>

<style scoped>

.titles {
	color: var(--color-text);
	margin-top: 0;
}

.title-zh {
	font-size: clamp(3rem, 5vw, 5rem);
	font-weight: 600;
	text-align: center;
	margin: 3rem 0 0;
}

.title-en {
	font-size: clamp(1rem, 2.1vw, 2.1rem);
	text-align: center;
	font-weight: 500;
	color: var(--color-primary);
	margin-top: 0.5rem;
}

.subtitles {
	border-top: var(--color-muted) 1px solid;
	font-size: 1.15rem;
	text-align: center;
	color: var(--color-muted);
	width: 40vw;
	margin: 3rem auto 0;
	padding-top: 2rem;
}

.subtitles p {
	margin: 0.25rem auto;
}

nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 2rem;

    width: 80vw;
    margin: 3rem auto 5rem;
}

nav div {
    display: flex;
    flex-direction: column;

    flex: 1 1 25rem;
    max-width: 30rem;
    min-width: 0;

    padding: 1rem 2.5rem 2rem;

    border: 2px solid var(--color-border);
    border-radius: 15px;
}

nav div h1 {
	margin-bottom: 1rem;
}

nav div p {
	margin-top: 0;
	margin-bottom: 3rem;
}

nav div a {
	color: var(--color-primary);
	text-decoration: none;
	margin-top: auto;
	transition: 100ms ease;
}

nav div a:hover {
	color: var(--color-primary-dark);
}

</style>