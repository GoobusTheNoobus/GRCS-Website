import "../styles/style.css"

interface Props {
    lang: "en" | "zh"
}

const {lang} = Astro.props

---

<nav>
    <div id="brand">
        <a href="/">
            <h1>
                泓河中文学校
            </h1>
            <p>
                Grand River Chinese School
            </p>
        </a>
    </div>

    <div class="nav-links">
        <a href={"/" + lang}>
            {lang == "en" ? "Home" : "首页"}
        </a>
        <a href={"/" + lang + "/courses"}>
            {lang == "en" ? "Chinese Courses" : "中文课"}
        </a>
        <a href={"/" + lang + "/interest"}>
            {lang == "en" ? "Interest Classes" : "兴趣课"}
        </a>
        <a href="https://grcs.pages.dev/">
            泓河开卷™ {lang == "en" ? "AI Reading" : "AI阅读"} [↗]
        </a>
        <a href={"/" + lang + "/GRCSJournal"}>
            {lang == "en" ? "School Journal" : "校刊"}
        </a>
    </div>

</nav>

<style>


nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;

    padding: 1rem 3rem;

    border-bottom: 2px solid var(--color-primary);

    margin-bottom: 3rem;
    user-select: none;
}

/* Brand */

#brand {
    display: flex;
    transition: 300ms ease;
    border-radius: 20px;
    padding: 0.25rem 1rem ;
    
}

#brand:hover {
    transform: translateY(-5);
    background-color: var(--color-border);
}

#brand a {
    display: flex;
    align-items: center;
    gap: 0.85rem;

    text-decoration: none;
    flex-direction: column;
    gap: 0;
}

#brand h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.7rem;
    font-weight: 600;
}

#brand p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.78rem;
}

/* Navs */

.nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem;

    min-width: 0;
}

.nav-links a {
    position: relative;

    padding: 0.65rem 0.85rem;

    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;

    border-radius: 6px;
    transition:
        color 150ms ease,
        background-color 150ms ease;
}

.nav-links a:hover {
    color: var(--color-primary);
    background-color: var(--color-border);
}

/* Mobile */

@media (max-width: 850px) {
    nav {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }

    .nav-links {
        justify-content: center;
        width: 100%;
    }
}

@media (max-width: 480px) {
    .nav-links {
        gap: 0.25rem;
    }

    .nav-links a {
        padding: 0.55rem 0.65rem;
        font-size: 0.85rem;
    }

    #brand h1 {
        font-size: 1.3rem;
    }
}


</style>