---
import "../styles/style.css"

interface Props {
    lang: "en" | "zh"
}

const {lang} = Astro.props

---

<nav>
    <div id="brand">
        <a href="/">
            <img src="/logo.png">
        </a>
    </div>

    <div class="nav-links">
        <a href={"/" + lang}>
            {lang == "en" ? "Home" : "首页"}
        </a>
        <a href={"/" + lang + "/courses"}>
            {lang == "en" ? "Chinese Courses" : "中文课"}
        </a>
        <a href={"/" + lang + "/interest"}>
            {lang == "en" ? "Interest Classes" : "兴趣课"}
        </a>
        <a href="https://grcs.pages.dev/">
            泓河开卷™ {lang == "en" ? "AI Reading" : "AI阅读"} [↗]
        </a>
    </div>

</nav>

<style>

nav {
    display: flex;
    gap: 4rem;
    padding: 2rem 3rem;

    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);

    border-radius: 0 0 40px 40px;
    height: 4rem;
}

.nav-links {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 3rem;
    align-items: center;
}

.nav-links a {
    color: var(--color-primary);
    text-decoration: none;
}

.nav-links a:hover {
    color: var(--color-primary-dark)
}

img {
    height: 3rem;
}

#brand a {
    display: flex;
    justify-content: center;
    gap: 1.6rem;
    text-decoration: none;
}


</style>