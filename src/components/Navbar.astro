---
import "../styles/style.css"

interface Props {
    lang: "en" | "zh"
}

const {lang} = Astro.props

---

<nav>
    <div id="brand">
        <a href="/">
            <img src="/logo.png">
            <h1>
                {lang == "en" ? "GRCS" : 
                "泓河中文学校"}
            </h1>
        </a>
    </div>

    <div class="nav-links">
        <a href={"/" + lang}>
            {lang == "en" ? "Home" : "首页"}
        </a>
        <a href={"/" + lang + "/courses"}>
            {lang == "en" ? "Chinese Courses" : "中文课"}
        </a>
        <a href={"/" + lang + "/interest"}>
            {lang == "en" ? "Interest Classes" : "兴趣课"}
        </a>
        <a href="https://grcs.pages.dev/">
            泓河开卷™ {lang == "en" ? "AI Reading" : "AI阅读"} [↗]
        </a>
        <a href={"/" + lang + "/GRCSJournal"}>
            {lang == "en" ? "School Journal" : "校刊"}
        </a>
    </div>

</nav>

<style>


nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 4rem 1.5rem 3rem;

    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-primary);

}

#brand {
    flex-shrink: 0;
}

#brand a {
    display: flex;
    align-items: center;
    text-decoration: none;
}

#brand a h1{
    text-decoration: none;
    color: var(--color-primary);
    padding-left: 1rem;
}

img {
    display: block;
    height: 3.5rem;
    width: auto;

    transition: 200ms ease;
    border-radius: 12px;
}

img:hover {
    border: 3px solid var(--color-primary-dark);
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 3rem;

    min-width: 0;
}

.nav-links a {
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
}

.nav-links a:hover {
    color: var(--color-primary-dark);
}

/*  Mobile layout  */
@media (max-width: 650px) {
    nav {
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        padding: 1.25rem 1rem;
        border-radius: 0 0 1.5rem 1.5rem;
    }

    .nav-links {
        justify-content: center;
        gap: 0.75rem 1.25rem;
        width: 100%;
    }

    .nav-links a {
        white-space: normal;
        text-align: center;
        font-size: 0.9rem;
    }
}



</style>